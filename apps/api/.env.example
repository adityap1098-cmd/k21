# K21 API — example environment variables
# Copy this file to .env and fill in real values before starting the server

# Server
NODE_ENV=development
PORT=3001

# Database (required)
DATABASE_URL=postgres://k21:changeme@localhost:5432/k21

# Redis (required for BullMQ queues)
REDIS_HOST=localhost
REDIS_PORT=6379

# Auth & RBAC (Phase 1)
JWT_SECRET=change-this-to-a-random-256-bit-secret-in-production
