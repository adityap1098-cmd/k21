{
  "name": "@k21/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "db:generate": "node --require tsx/cjs node_modules/drizzle-kit/bin.cjs generate:pg",
    "db:push": "node --require tsx/cjs node_modules/drizzle-kit/bin.cjs push:pg"
  },
  "dependencies": {
    "@k21/shared": "workspace:*",
    "argon2": "^0.44.0",
    "bullmq": "^5.0.0",
    "cookie-parser": "^1.4.7",
    "drizzle-orm": "^0.30.0",
    "express": "^4.18.0",
    "ioredis": "^5.3.0",
    "jose": "^6.2.1",
    "postgres": "^3.4.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.0",
    "@types/supertest": "^6.0.0",
    "@vitest/coverage-v8": "^1.6.0",
    "drizzle-kit": "^0.20.0",
    "supertest": "^7.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
