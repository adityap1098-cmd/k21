# Database (connects to PgBouncer, NOT Postgres directly)
DATABASE_URL=postgres://appuser:CHANGEME@pgbouncer:5432/k21

# Postgres internal credentials (used by postgres container, NOT by app)
POSTGRES_USER=appuser
POSTGRES_PASSWORD=CHANGEME
POSTGRES_DB=k21

# Redis
REDIS_PASSWORD=CHANGEME

# GPG encryption (base64-encoded GPG passphrase for backup encryption)
GPG_PASSPHRASE=CHANGEME

# Backblaze B2
B2_KEY_ID=CHANGEME
B2_APPLICATION_KEY=CHANGEME
B2_BUCKET=k21-backups

# Domain + SSL
DOMAIN=yourdomain.com
LETSENCRYPT_EMAIL=admin@yourdomain.com

# Application
PORT=3001
NODE_ENV=production
